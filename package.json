{
  "name": "tree-sitter-epscript",
  "version": "1.0.1",
  "description": "epScript grammar for tree-sitter",
  "repository": "https://github.com/zuhanit/tree-sitter-epscript.git",
  "license": "MIT",
  "author": "Joo Han, Ham <zuhanit3@gmail.com>",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": ["tree-sitter", "parser", "epscript"],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "devDependencies": {
    "@types/node": "^25.3.5",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "prebuildify": "^6.0.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-cli": "^0.22.6",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "node-addon-api": "^8.6.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "test:parse": "tsx test/parse_all.ts",
    "parse": "tree-sitter parse"
  }
}
